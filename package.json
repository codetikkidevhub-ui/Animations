{
  "name": "animations-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "A categorized React animation library with docs catalog and Remotion video compositions",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "pnpm --filter docs dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "studio": "pnpm --filter video studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
